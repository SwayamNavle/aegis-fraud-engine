# ==============================================================================
# AEGIS ENGINE CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_secure_password
POSTGRES_DB=aegis_fraud_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis_admin:aegis_secure_password@localhost:5432/aegis_fraud_db
DATABASE_SYNC_URL=postgresql://aegis_admin:aegis_secure_password@localhost:5432/aegis_fraud_db

# Local SQLite Fallback (used automatically if PostgreSQL is unreachable)
SQLITE_DB_PATH=data/aegis.db

# Redis Configuration (Optional Hot Feature Cache & Idempotency store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_FEATURES=transactions.features
KAFKA_TOPIC_PREDICTIONS=transactions.predictions
KAFKA_TOPIC_ALERTS=transactions.alerts
KAFKA_TOPIC_DEAD_LETTER=transactions.dead_letter
KAFKA_CONSUMER_GROUP=aegis-streaming-consumers
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Spark Structured Streaming Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=AegisStreamingEngine
SPARK_CHECKPOINT_DIR=data/checkpoints/spark
SPARK_WATERMARK_DELAY=10 minutes
SPARK_WINDOW_DURATION=5 minutes
SPARK_SLIDE_DURATION=1 minute

# Fraud Detection Model & Scoring Service
MODEL_PATH=ml/models/xgb_fraud_model.json
MODEL_SCHEMA_PATH=ml/artifacts/feature_schema.json
MODEL_METADATA_PATH=ml/artifacts/training_metadata.json
MODEL_VERSION=xgb-v1.0.0
SCORING_SERVICE_URL=http://localhost:8001
SCORING_HOST=0.0.0.0
SCORING_PORT=8001

# Fraud Thresholds
FRAUD_THRESHOLD=0.70
HIGH_RISK_THRESHOLD=0.70
MEDIUM_RISK_THRESHOLD=0.40

# FastAPI Backend & WebSocket Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
METRICS_PORT=8000

# Performance & Benchmarking
BENCHMARK_DURATION_SECONDS=30
BENCHMARK_CONCURRENCY=50
